# Upstream ComfyUI wrapper endpoint. Accepts multipart/form-data with
# `image` (file) + `prompt` (text), responds with PNG bytes.
# Leave empty to fall back to the built-in mock generator.
COMFYUI_ENDPOINT=https://blush-fancy-science.ngrok-free.dev/run

# Reference image used when the frontend doesn't pass one. The frontend
# now pulls the page's hero <img> automatically, so this is just a fallback.
DEFAULT_REFERENCE_IMAGE=https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=70

# Cosmetic delay on the mock generator so the loading state is visible.
MOCK_DELAY_SECONDS=1.4
