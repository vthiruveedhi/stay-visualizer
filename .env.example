# ComfyUI server URL. Leave empty to run with the built-in mock generator
# (returns curated stock images so the demo is functional end-to-end).
# Set to e.g. https://comfy.example.com once available.
COMFYUI_URL=

# Path to the Flux Kontext workflow JSON (exported from ComfyUI's
# "Save (API Format)" button). Drop the file at this path.
COMFYUI_WORKFLOW_PATH=workflows/flux_kontext.json

# Default reference image fed to Flux Kontext. Replace with the real
# property image URL when integrating into the booking site.
DEFAULT_REFERENCE_IMAGE=https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=1200&q=70

# Cosmetic delay on the mock generator so the loading state is visible.
MOCK_DELAY_SECONDS=1.4
